# Production Environment Configuration
# Copy this file to .env on your VPS and fill in strong random secrets

# PostgreSQL Database
POSTGRES_DB=syncpro_prod
POSTGRES_USER=syncpro_admin
POSTGRES_PASSWORD=generate_super_strong_password_here

# Object Storage (MinIO / S3)
S3_ACCESS_KEY=syncpro_s3_root_admin
S3_SECRET_KEY=generate_s3_secret_key_here
S3_BUCKET_COMMITS=syncpro-commits
S3_BUCKET_SNAPSHOTS=syncpro-snapshots

# Redis
REDIS_PASSWORD=generate_redis_secret_password_here

# JWT Authentication — REQUIRED, must be at least 32 characters
JWT_SECRET=generate_jwt_secret_minimum_32_chars_here

# Next.js Frontend
PORT=3000
NODE_ENV=production
